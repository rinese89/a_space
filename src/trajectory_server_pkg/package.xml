<?xml version="1.0"?>
<package format="3">
  <name>trajectory_server_pkg</name>
  <version>0.7.0</version>
  <description>Runtime trajectory activation server with supervision-aware cropped trajectories and separated non-priority adjustment output.</description>
  <maintainer email="maintainer@example.com">A-space</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>px4_msgs</depend>
  <depend>collision_detection</depend>
  <depend>static_trajectory_manager</depend>
  <depend>static_trajectory_conflict_manager</depend>
  <depend>trajectory_endtime_adjustment</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <export><build_type>ament_cmake</build_type></export>
</package>
