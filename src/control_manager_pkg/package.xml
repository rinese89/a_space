<?xml version="1.0"?>
<package format="3">
  <name>control_manager_pkg</name>
  <version>0.2.0</version>

  <description>
    Per-UAS ROS 2 Humble control manager. Trajectories are acquired through
    flight_zone_supervision/SupervisionControl instead of subscribing directly
    to /active_trajectories. Existing takeoff, mission, pause/resume, stop,
    trajectory monitoring and landing behavior is preserved.
  </description>

  <maintainer email="maintainer@example.com">A-space</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>controllers_pkg</depend>
  <depend>static_trajectory_manager</depend>
  <depend>flight_zone_supervision</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
