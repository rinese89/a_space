+
+      default:
+        RCLCPP_WARN(
+          get_logger(),
+          "[/%s] Rejecting unknown supervision action command=%u",
+          drone_namespace_.c_str(),
+          static_cast<unsigned>(goal->command));
+        return rclcpp_action::GoalResponse::REJECT;
+    }
+  }
