+
+    switch (goal->command) {
+      case SupervisionControl::Goal::EXECUTE:
+      case SupervisionControl::Goal::PAUSE:
+      case SupervisionControl::Goal::RESUME:
+      case SupervisionControl::Goal::STOP:
