<?xml version="1.0"?>
<package format="3">
  <name>distance_control</name>
  <version>0.1.1</version>
  <description>Dynamic pairwise XY distance computation for active A-space UAS.</description>

  <maintainer email="maintainer@example.com">A-space</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <depend>rclcpp</depend>
  <depend>flight_zone_msgs</depend>
  <depend>static_trajectory_manager</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
