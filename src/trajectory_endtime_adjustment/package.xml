<?xml version="1.0"?>
<package format="3">
  <name>trajectory_endtime_adjustment</name>
  <version>0.4.0</version>
  <description>
    Computes trajectory timing corrections from active-trajectory lifecycle
    while preserving the complete multi-mission StaticTrajectory geometry,
    including duration-relative correction for delayed priority operations.
  </description>

  <maintainer email="maintainer@example.com">A-space</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>builtin_interfaces</depend>
  <depend>static_trajectory_manager</depend>

  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
