<?xml version="1.0"?>
<package format="3">
  <name>static_trajectory_conflict_manager</name>
  <version>0.4.0</version>
  <description>
    Simplified first-stage static trajectory classifier for A-space. It stores
    only collision-free trajectories as the comparison set, stops at the first
    spatial collision, and publishes authoritative available/collision
    snapshots without detailed collision evidence.
  </description>

  <maintainer email="maintainer@example.com">A-space</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>

  <depend>rclcpp</depend>
  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>static_trajectory_manager</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
