        <mxCell id="EyQgIoDrQc9ge1tGa88R-6" parent="IIoP1VmYtMiaxPXChmDk-214" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontStyle=0" value="&lt;div&gt;&lt;b&gt;SUPERVISOR_NODE&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;supervisado y no supervisado se aproximan&lt;/div&gt;        ↓&lt;br&gt;distancia XY &amp;lt; 1.5 m&lt;br&gt;        ↓&lt;br&gt;PAUSE ambos&lt;br&gt;        ↓&lt;br&gt;esperar ACK de ambos PAUSE&lt;br&gt;        ↓&lt;br&gt;comando 3 al supervisado: subir +1.0 m&lt;br&gt;        ↓&lt;br&gt;esperar ACK de elevación&lt;br&gt;        ↓&lt;br&gt;RESUME no supervisado&lt;br&gt;        ↓&lt;br&gt;seguir monitorizando su separación XY&lt;br&gt;        ↓&lt;br&gt;distancia XY &amp;gt; 2.0 m&lt;br&gt;        ↓&lt;br&gt;dejar de supervisar ese par&lt;br&gt;        ↓&lt;br&gt;comando 4 al supervisado: volver a altura previa&lt;br&gt;        ↓&lt;br&gt;esperar ACK de descenso&lt;br&gt;        ↓&lt;br&gt;RESUME supervisado" vertex="1">
          <mxGeometry height="400" width="290" x="2301" y="2653" as="geometry" />
        </mxCell>
        <mxCell id="EyQgIoDrQc9ge1tGa88R-8" parent="IIoP1VmYtMiaxPXChmDk-214" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;b&gt;CONTROL_MANAGER_NODE&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;MISSION_ACTIVE&lt;/div&gt;       │&lt;br&gt;       &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;│ PAUSE=1&lt;br&gt;       ▼&lt;br&gt;PAUSE_CANCELING&lt;br&gt;       │&lt;br&gt;       &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp;│ ELEVATE=3 puede llegar aquí&lt;br&gt;       &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp; │ y queda en cola&lt;br&gt;       ▼&lt;br&gt;PAUSED / controller HOLD&lt;br&gt;       │&lt;br&gt;       &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;   &lt;/span&gt;│ capturar posición real&lt;br&gt;       ▼&lt;br&gt;reference = (x0, y0, z0)&lt;br&gt;       │&lt;br&gt;       ▼&lt;br&gt;VERTICAL_ELEVATE_DISPATCH&lt;br&gt;       │&lt;br&gt;       &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;│ FollowWaypoints:&lt;br&gt;       &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp; &amp;nbsp;│ x = x0&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;│ y = y0&lt;br&gt;       &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp; &amp;nbsp; │ height = z0 + 1.0&lt;br&gt;       ▼&lt;br&gt;VERTICAL_ELEVATE_ACTIVE&lt;br&gt;       │&lt;br&gt;       &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;│ action success&lt;br&gt;       ▼&lt;br&gt;PAUSED&lt;br&gt;pero elevado a z0 + 1 m" vertex="1">
          <mxGeometry height="451" width="410" x="2511" y="2655" as="geometry" />
        </mxCell>
