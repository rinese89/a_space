        <mxCell id="iMGC5zJTy4-5H1KIjFv7-48" parent="IIoP1VmYtMiaxPXChmDk-214" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=18;" value="&lt;div&gt;Comprobación de:&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Trayectoria de misión&amp;nbsp;dentro de la FZ.&amp;nbsp;(Ignora VTOL)&lt;/li&gt;&lt;li&gt;Tiempo Válido&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="241" x="3822" y="215" as="geometry" />
        </mxCell>
        <mxCell id="iMGC5zJTy4-5H1KIjFv7-54" parent="IIoP1VmYtMiaxPXChmDk-214" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;div&gt;Control de tiempo final:&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Medición del tiempo&amp;nbsp;final real de ejecución&amp;nbsp;[extra time]&lt;/li&gt;&lt;li&gt;&lt;div&gt;Reajuste de tiempo&lt;/div&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="270" x="4221" y="1288.5" as="geometry" />
        </mxCell>
        <mxCell id="iMGC5zJTy4-5H1KIjFv7-63" parent="IIoP1VmYtMiaxPXChmDk-214" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;div&gt;Clasificación gruesa de trayectorias por colisión:&lt;ul&gt;&lt;li&gt;Detección&amp;nbsp;&lt;/li&gt;&lt;li&gt;Almacenamiento&amp;nbsp;de las trayectorias disponibles sin colisión (hasta 15s después de la última aparición en el tópico) [disappearance_grace_s: 15.0]&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="459" x="3891" y="680" as="geometry" />
        </mxCell>
        <mxCell id="iMGC5zJTy4-5H1KIjFv7-69" parent="IIoP1VmYtMiaxPXChmDk-214" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;div&gt;Control de publicación de trayectorias activas:&lt;br&gt;&lt;ul&gt;&lt;li&gt;No puede haber dos trayectorias estáticas activas (publicadas) en colisión&lt;/li&gt;&lt;li&gt;En caso de conflicto por ajuste entre la trayectoria candidata y la activa:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;1. Si la trayectoria candidata es de igual prioridad a la activa, se publica justo a continuación modificando sus valores de tiempo inicial y final de manera permanente.&amp;nbsp;&lt;/li&gt;&lt;li&gt;2. Si la&amp;nbsp;trayectoria&amp;nbsp;candidata es prioritaria, se activa el servicio y se publica en &#39;/active_trajectories&#39; a continuación con modificación de tiempo inicial y final no permanente. En el próximo periodo, la de primera activación pasa al tópico de colisión.&lt;/li&gt;&lt;li&gt;3. Si la&amp;nbsp;trayectoria&amp;nbsp;candidata&amp;nbsp;no es prioritaria se publica en &#39;/non_priority_adjustment_trajectories&#39;.&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Modifica el tiempo inicial de la trayectoria que entra en colisión por ajuste de tiempo.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="265" width="659.01" x="3891" y="1005" as="geometry" />
        </mxCell>
