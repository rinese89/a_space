<?xml version="1.0"?>
<package format="3">
  <name>supervision_trajectory_manager</name>
  <version>0.5.0</version>

  <description>
    Acquires ready-to-use multi-mission cropped StaticTrajectory objects from
    deconfliction_manager, injects them unchanged, confirms them in AVAILABLE,
    publishes the original collision payload as supervised state, and
    synchronizes periodic occurrence times.
  </description>

  <maintainer email="maintainer@example.com">A-space</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>

  <depend>a_space_virtual_net</depend>

  <depend>collision_detection</depend>
  <depend>deconfliction_manager</depend>
  <depend>static_trajectory_manager</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
