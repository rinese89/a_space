# One target-trajectory lattice segment whose edge_id is also used by at least
# one other loaded trajectory.

uint64 edge_id
uint8 axis

uint64 start_node_id
uint64 end_node_id
geometry_msgs/Point start
geometry_msgs/Point end
float64 length_m

uint8 phase

# For MISSION this is the global phase-local source-edge index generated by
# a_space_virtual_net across mission[] components and repetitions.
# Consecutive indices do NOT imply geometric continuity between independent
# mission components.
uint32 original_phase_segment_index

# Order inside the net-loaded projection stream. Connectivity must be inferred
# from start_node_id/end_node_id, not from consecutive indices alone.
uint32 net_segment_index

# Other trajectory IDs that also use this exact virtual-net edge.
string[] conflicting_trajectory_ids
